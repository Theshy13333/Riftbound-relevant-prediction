        var TOTALS = {"total_decks":3599,"total_cards":734,"cards_with_winrate":369,"avg_winrate":52.8,"median_play":3.4,"min_games":50};
        // Same bar as the metashare table, rendered once as a template
        var BAR_TEMPLATE = "\u003Cdiv class=\"progress progress-sm position-relative\" style=\"height: 25px;min-width: 70px\"\u003E\n    \u003Cdiv class=\"progress-bar bg-cyan\" style=\"width: __VALUE__%\"\n         role=\"progressbar\" aria-valuenow=\"__VALUE__\" aria-valuemin=\"0\" aria-valuemax=\"100\"\n         aria-label=\"__VALUE__% Play rate\"\u003E\n        \u003Cspan class=\"visually-hidden\"\u003E__VALUE__% Play rate\u003C\/span\u003E\n    \u003C\/div\u003E\n    \u003Cspan class=\"position-absolute top-50 start-50 translate-middle text-white\" style=\"font-size:12px\"\u003E__VALUE__%\u003C\/span\u003E\n\u003C\/div\u003E\n";
        var WEBROOT = '/';
        var CARD_URL = '/cards/details---SLUG--';

        var DOMAINS = {
            body: {label: 'Body', color: '#E87500'},
            calm: {label: 'Calm', color: '#488C38'},
            chaos: {label: 'Chaos', color: '#643D8A'},
            fury: {label: 'Fury', color: '#D01B23'},
            mind: {label: 'Mind', color: '#0F6FA6'},
            order: {label: 'Order', color: '#CAAD16'},
            multi: {label: 'Multi Domain', color: '#e9964f'},
            colorless: {label: 'Colorless', color: '#8f8f8f'}
        };

        var state = {search: '', domain: '', type: '', sort: 'play', visible: 100};

        function cardUrl(card) {
            return CARD_URL.replace('--SLUG--', encodeURIComponent(card.slug));
        }

        function imgUrl(card) {
            return WEBROOT.replace(/\/$/, '') + card.img;
        }

        function fullImgUrl(card) {
            return WEBROOT.replace(/\/$/, '') + card.full_img;
        }

        function filtered() {
            var search = state.search.toLowerCase();
            return DATA.filter(function(c) {
                if (search && c.name.toLowerCase().indexOf(search) === -1) return false;
                if (state.domain && c.domain !== state.domain) return false;
                if (state.type && c.type.toLowerCase().indexOf(state.type) === -1) return false;
                return true;
            });
        }

        function sorted(cards) {
            var key = state.sort;
            return cards.slice().sort(function(a, b) {
                if (key === 'name') return a.name.localeCompare(b.name);
                var av = (a[key] === null) ? -1 : a[key];
                var bv = (b[key] === null) ? -1 : b[key];
                return bv - av;
            });
        }

        // ---- Table ----

        function esc(value) {
            return String(value).replace(/[&<>"']/g, function(ch) {
                return {'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'}[ch];
            });
        }

        function rowHtml(card) {
            var domain = DOMAINS[card.domain] || DOMAINS.colorless;

            var winHtml;
            if (card.win === null) {
                winHtml = '<span class="text-muted" title="Less than ' + TOTALS.min_games + ' games recorded">—</span>';
            } else if (card.win >= TOTALS.avg_winrate) {
                winHtml = '<b class="text-cyan">' + card.win.toFixed(1) + '%</b>';
            } else {
                winHtml = '<span>' + card.win.toFixed(1) + '%</span>';
            }

            var imgHtml = (card.img && card.full_img)
                ? '<a href="' + cardUrl(card) + '" class="me-2 flex-shrink-0">' +
                '<img src="' + esc(imgUrl(card)) + '" loading="lazy" alt="' + esc(card.name) + '" width="44" height="44" style="border-radius:6px;object-fit:cover;border:1px solid ' + domain.color + '55">' +
                '</a>'
                : '';

            return '<tr>' +
                '<td>' +
                '<div class="d-flex align-items-center">' +
                imgHtml +
                '<div class="text-truncate">' +
                '<a href="' + cardUrl(card) + '" class="d-block text-truncate"><b class="text-white">' + esc(card.name) + '</b></a>' +
                '<span class="text-muted small">' +
                '<span style="color:' + domain.color + '">&#9679;</span> ' + esc(card.type) + (card.set ? ' &middot; ' + esc(card.set) : '') +
                '</span>' +
                '</div>' +
                '</div>' +
                '</td>' +
                '<td class="text-end stats-mono">' + card.copies.toFixed(1) + '</td>' +
                '<td class="stats-mono" style="min-width:110px">' +
                BAR_TEMPLATE.split('__VALUE__').join(card.play.toFixed(1)) +
                '</td>' +
                '<td class="text-end stats-mono">' + winHtml + '</td>' +
                '<td class="text-end stats-mono text-muted">' + card.decks + '</td>' +
                '</tr>';
        }

        function renderTable(cards) {
            var rows = cards.slice(0, state.visible).map(function(c) {
                return rowHtml(c);
            });
            document.getElementById('stats-tbody').innerHTML = rows.join('');
            document.getElementById('show-more-wrap').style.display = (cards.length > state.visible) ? '' : 'none';
        }

        // ---- Chart ----

        var chart = null;
        var seriesMeta = [];

        function buildSeries(cards) {
            var groups = {};
            cards.forEach(function(c) {
                if (c.win === null) return;
                var key = DOMAINS[c.domain] ? c.domain : 'colorless';
                (groups[key] = groups[key] || []).push(c);
            });

            var series = [];
            var colors = [];
            seriesMeta = [];
            Object.keys(DOMAINS).forEach(function(key) {
                if (!groups[key]) return;
                series.push({
                    name: DOMAINS[key].label,
                    data: groups[key].map(function(c) {
                        return [c.play, c.win];
                    })
                });
                colors.push(DOMAINS[key].color);
                seriesMeta.push(groups[key]);
            });
            return {series: series, colors: colors};
        }

        function chartBounds() {
            var maxX = 0, minY = 100, maxY = 0;
            DATA.forEach(function(c) {
                if (c.win === null) return;
                maxX = Math.max(maxX, c.play);
                minY = Math.min(minY, c.win);
                maxY = Math.max(maxY, c.win);
            });
            return {
                maxX: Math.ceil(maxX + 2),
                minY: Math.max(0, Math.floor(minY - 3)),
                maxY: Math.min(100, Math.ceil(maxY + 3))
            };
        }

        function quadrantAnnotations(bounds) {
            var labelStyle = {
                fontSize: '11px',
                fontWeight: 700,
                color: '#8b93a7'
            };

            function corner(x, y, text, anchor, offsetY) {
                return {
                    x: x,
                    y: y,
                    marker: {size: 0},
                    label: {
                        text: text,
                        textAnchor: anchor,
                        borderWidth: 0,
                        offsetY: offsetY,
                        style: {background: 'transparent', fontSize: labelStyle.fontSize, fontWeight: labelStyle.fontWeight, color: labelStyle.color}
                    }
                };
            }

            return [
                corner(bounds.maxX * 0.01, bounds.maxY, 'SLEEPERS', 'start', 10),
                corner(bounds.maxX * 0.99, bounds.maxY, 'STAPLES', 'end', 10),
                corner(bounds.maxX * 0.01, bounds.minY, 'FRINGE', 'start', 0),
                corner(bounds.maxX * 0.99, bounds.minY, 'OVERPLAYED', 'end', 0)
            ];
        }

        function renderChart(cards) {
            var el = document.getElementById('meta-map');
            if (!el || typeof ApexCharts === 'undefined') return;

            var built = buildSeries(cards);

            if (chart) {
